# AI Filmmaking Studio - Environment Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# AI Provider API Keys (at least one required per category)
# ============================================

# Script Generation (choose one)
FILMSTUDIO_ANTHROPIC_API_KEY=        # Claude API key for screenplay generation
FILMSTUDIO_OPENAI_API_KEY=           # OpenAI API key (alternative for scripts, also used for DALL-E and TTS)

# Image Generation (Nano Banana = Gemini Image Gen - PRIMARY)
FILMSTUDIO_GOOGLE_API_KEY=           # Google AI API key for Nano Banana (Gemini image generation + editing)
# Alternatives:
# OpenAI key above covers DALL-E 3
FILMSTUDIO_REPLICATE_API_TOKEN=      # Replicate token (for Flux Pro images, LTX-Video, Stable Audio)

# Video Generation (choose one)
FILMSTUDIO_RUNWAY_API_KEY=           # Runway API key for Gen-4 video generation
# Replicate token above also covers LTX-Video

# Voice / TTS (choose one)
FILMSTUDIO_ELEVENLABS_API_KEY=       # ElevenLabs API key for voice synthesis and SFX
# OpenAI key above also covers OpenAI TTS

# Music Generation
FILMSTUDIO_STABILITY_API_KEY=        # Stability AI key (optional, Replicate covers Stable Audio)

# ============================================
# Model Preferences (optional - defaults shown)
# ============================================

# FILMSTUDIO_SCRIPT_MODEL=claude-sonnet-4-20250514
# FILMSTUDIO_IMAGE_PROVIDER=gemini           # gemini (Nano Banana), openai, or replicate
# FILMSTUDIO_IMAGE_MODEL=gemini-2.5-flash-preview-image-generation
# FILMSTUDIO_VIDEO_PROVIDER=runway           # runway or replicate
# FILMSTUDIO_VIDEO_MODEL=gen4_turbo
# FILMSTUDIO_VOICE_PROVIDER=elevenlabs       # elevenlabs or openai
# FILMSTUDIO_VOICE_MODEL=eleven_multilingual_v2
# FILMSTUDIO_MUSIC_PROVIDER=replicate

# ============================================
# Application Settings (optional)
# ============================================

# FILMSTUDIO_HOST=127.0.0.1
# FILMSTUDIO_PORT=8741
# FILMSTUDIO_DEBUG=false
# FILMSTUDIO_PROJECTS_DIR=~/AIFilmStudio/projects
# FILMSTUDIO_DEFAULT_RESOLUTION=1920x1080
# FILMSTUDIO_DEFAULT_FPS=24
# FILMSTUDIO_STORYBOARD_FRAMES_PER_SCENE=3
